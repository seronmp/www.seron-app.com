---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Home">
    <div class="text-center py-10 space-y-6">
        <h1 class="text-4xl md:text-6xl font-black text-brand tracking-tight uppercase">Software Solutions</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto font-medium">Soluzioni digitali e gestionali avanzate per le aziende. Sviluppato da Seron S.r.l.</p>
        <div class="pt-4">
            <a href="/privacy" class="inline-block bg-brand text-white font-bold px-8 py-3 rounded-xl shadow-lg shadow-brand/20 hover:scale-105 transition">Leggi la Privacy Policy</a>
        </div>
    </div>
</Layout>