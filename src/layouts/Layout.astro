---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title} - Seron S.r.l.</title>
    <!-- Tailwind CSS CDN -->
    <script is:inline src="https://cdn.tailwindcss.com"></script>
    <script is:inline>
        tailwind.config = {
            theme: {
                extend: {
                    colors: { brand: '#3B204B' },
                    fontFamily: { sans: ['Inter', 'system-ui', 'sans-serif'] }
                }
            }
        }
    </script>
    <style>
        @keyframes float1 {
            0% { transform: translate(-5%, -5%) rotate(0deg); }
            50% { transform: translate(5%, 5%) rotate(180deg); }
            100% { transform: translate(-5%, -5%) rotate(360deg); }
        }
        @keyframes float2 {
            0% { transform: translate(5%, -10%) rotate(360deg); }
            50% { transform: translate(-5%, 10%) rotate(180deg); }
            100% { transform: translate(5%, -10%) rotate(0deg); }
        }
        .curved-line {
            position: fixed; border-style: solid; z-index: -4; pointer-events: none;
        }
        .line-1 { width: 150vw; height: 150vw; top: -25%; left: -25%; border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%; border-width: 1px; border-color: rgba(59,32,75, 0.2); animation: float1 45s linear infinite; }
        .line-2 { width: 180vw; height: 120vw; top: -10%; right: -30%; border-radius: 55% 45% 62% 38% / 41% 65% 35% 59%; border-width: 3px; border-color: rgba(59,32,75, 0.08); animation: float2 60s linear infinite; }
        .line-3 { width: 200vw; height: 200vw; bottom: -50%; left: -50%; border-radius: 35% 65% 45% 55% / 55% 45% 65% 35%; border-width: 6px; border-color: rgba(59,32,75, 0.04); animation: float1 80s linear infinite reverse; }
        .line-4 { width: 120vw; height: 180vw; top: -40%; left: 10%; border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; border-width: 2px; border-color: rgba(59,32,75, 0.12); animation: float2 50s linear infinite reverse; }
        .line-5 { width: 140vw; height: 140vw; top: 10%; left: -20%; border-radius: 70% 30% 50% 50% / 30% 70% 50% 50%; border-width: 1px; border-color: rgba(59,32,75, 0.15); animation: float1 35s linear infinite; }
    </style>
</head>
<body class="bg-slate-50 text-gray-800 font-sans flex flex-col min-h-screen relative overflow-x-hidden m-0 p-0">

    <!-- Linee Curve Animate -->
    <div class="curved-line line-1"></div>
    <div class="curved-line line-2"></div>
    <div class="curved-line line-3"></div>
    <div class="curved-line line-4"></div>
    <div class="curved-line line-5"></div>

    <!-- Sfere di luce -->
    <div class="fixed top-0 left-0 w-full h-full overflow-hidden -z-10 pointer-events-none">
        <div class="absolute top-[-10%] left-[-5%] w-[40vw] h-[40vw] bg-purple-300 rounded-full mix-blend-multiply filter blur-[100px] opacity-40"></div>
        <div class="absolute top-[20%] right-[-10%] w-[45vw] h-[45vw] bg-brand rounded-full mix-blend-multiply filter blur-[120px] opacity-15"></div>
        <div class="absolute bottom-[-10%] left-[10%] w-[50vw] h-[50vw] bg-indigo-200 rounded-full mix-blend-multiply filter blur-[120px] opacity-30"></div>
    </div>

    <!-- Header Globale -->
    <Header />

    <!-- Contenitore Principale delle Pagine -->
    <main class="flex-grow max-w-4xl mx-auto px-4 py-16 w-full box-border">
        <div class="bg-white/70 backdrop-blur-xl p-8 md:p-14 rounded-3xl shadow-2xl shadow-brand/10 border border-white relative z-10">
            <slot />
        </div>
    </main>

    <!-- Footer Globale -->
    <Footer />

</body>
</html>