---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home - Seron S.r.l.">
  <main class="flex-grow max-w-4xl mx-auto px-4 py-16 w-full box-border">
    <div class="bg-white/70 backdrop-blur-xl p-8 md:p-14 rounded-3xl shadow-2xl shadow-brand/10 border border-white relative">

      <!-- Intestazione -->
      <div class="text-center py-10 space-y-6">
        <h1 class="text-4xl md:text-6xl font-black text-brand tracking-tight uppercase">Software Solutions</h1>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto font-medium">Fortschrittliche digitale und Verwaltungslösungen für Unternehmen.</p>
      </div>

      <!-- Sezione Applicazioni con Effetti Dinamici -->
      <div class="mt-16 w-full border-t border-gray-200/60 pt-12">
        <h2 class="text-2xl md:text-3xl font-bold text-brand uppercase text-center mb-12">Unsere Apps</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          
          <!-- Card: Salon -->
          <a href="https://whatsapp-salon-api.emergent.host" target="_blank" rel="noopener noreferrer" 
             class="group relative bg-white/80 backdrop-blur-md p-8 rounded-2xl shadow-lg border border-white/50 transition-all duration-300 transform hover:-translate-y-2 hover:shadow-2xl hover:border-brand/40 overflow-hidden">
            <div class="absolute top-0 left-0 w-2 h-full bg-blue-500 transition-all duration-300 group-hover:w-3"></div>
            <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-blue-500/10 rounded-full blur-2xl group-hover:bg-blue-500/20 transition-all"></div>
            <h3 class="text-xl font-bold text-gray-800 group-hover:text-blue-600 transition-colors mb-2">Salon</h3>
            <p class="text-gray-600 text-sm leading-relaxed">Terminverwaltung und -organisation. Optimieren Sie Ihre Arbeitsabläufe mit unserer speziellen Lösung.</p>
          </a>

          <!-- Card: Tableator -->
            <a href="/tableator" 
               class="group relative bg-white/80 backdrop-blur-md p-8 rounded-2xl shadow-lg border border-white/50 transition-all duration-300 transform hover:-translate-y-2 hover:shadow-2xl hover:border-indigo-500/40 overflow-hidden">
              <div class="absolute top-0 left-0 w-2 h-full bg-indigo-500 transition-all duration-300 group-hover:w-3"></div>
              <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-indigo-500/10 rounded-full blur-2xl group-hover:bg-indigo-500/20 transition-all"></div>
              <h3 class="text-xl font-bold text-gray-800 group-hover:text-indigo-600 transition-colors mb-2">Tableator</h3>
              <p class="text-gray-600 text-sm leading-relaxed">Fortschrittliches Tool zur Bearbeitung und dynamischen Darstellung der Tische in Restaurants und Pizzerien.</p>
            </a>

          <!-- Card: Zeitlr -->
          <a href="https://seromp.github.io/Zeitlr/" target="_blank" rel="noopener noreferrer" 
             class="group relative bg-white/80 backdrop-blur-md p-8 rounded-2xl shadow-lg border border-white/50 transition-all duration-300 transform hover:-translate-y-2 hover:shadow-2xl hover:border-brand/40 overflow-hidden">
            <div class="absolute top-0 left-0 w-2 h-full bg-purple-500 transition-all duration-300 group-hover:w-3"></div>
            <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-purple-500/10 rounded-full blur-2xl group-hover:bg-purple-500/20 transition-all"></div>
            <h3 class="text-xl font-bold text-gray-800 group-hover:text-purple-600 transition-colors mb-2">Zeitlr</h3>
            <p class="text-gray-600 text-sm leading-relaxed">Intelligente Verwaltung und Nachverfolgung von Zeitplänen und Unternehmensaktivitäten.</p>
          </a>
          <!-- Card: Calcolatore Acustico -->
          <a href="https://seronmp.github.io/RaumAkustikRechner/" target="_blank" rel="noopener noreferrer" class="group relative bg-white/80 backdrop-blur-md p-8 rounded-2xl shadow-lg border border-white/50 transition-all duration-300 transform hover:-translate-y-2 hover:shadow-2xl hover:border-emerald-500/40 overflow-hidden">
            <div class="absolute top-0 left-0 w-2 h-full bg-emerald-500 transition-all duration-300 group-hover:w-3"></div>
            <div class="absolute -right-10 -bottom-10 w-32 h-32 bg-emerald-500/10 rounded-full blur-2xl group-hover:bg-emerald-500/20 transition-all"></div>
            <h3 class="text-xl font-bold text-gray-800 group-hover:text-emerald-600 transition-colors mb-2">Calcolatore Acustico</h3>
            <p class="text-gray-600 text-sm leading-relaxed">Professionelles Tool zur Berechnung der Nachhallzeit und zur Optimierung der akustischen Gestaltung.</p>
          </a>
        </div>
      </div>

    </div>
  </main>
</Layout>