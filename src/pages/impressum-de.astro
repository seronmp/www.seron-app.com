---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Impressum - Seron S.r.l.">
  <main class="flex-grow max-w-4xl mx-auto px-4 py-24 w-full relative z-10 text-gray-800">
    <div class="mb-12">
      <h1 class="text-4xl md:text-5xl font-black mb-4 tracking-tight">Impressum</h1>
      <p class="text-gray-500 text-sm">Pflichtangaben gemäß geltendem Recht.</p>
    </div>
    
    <div class="space-y-8 text-base md:text-lg leading-relaxed text-gray-700 bg-white/60 backdrop-blur-xl p-8 md:p-12 rounded-3xl shadow-xl border border-white/80">
      <section>
        <h2 class="text-xl font-bold text-gray-900 mb-3">Unternehmensangaben</h2>
        <p><strong>Seron S.r.l.</strong></p>
        <p>Glorenzstraße 20</p>
        <p>39025 Mals (BZ) - Italien</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-gray-900 mb-3">Kontakt</h2>
        <p><strong>E-Mail:</strong> info@seron-app.com</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-gray-900 mb-3">Handelsregister & MwSt.</h2>
        <p><strong>MwSt.-Nr. & Steuernummer:</strong> 03215630215</p>
        <p><strong>REA-Nummer:</strong> BZ - 241706</p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-gray-900 mb-3">Online-Streitbeilegung (OS)</h2>
        <p class="text-base text-gray-600">
          Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit, die Sie hier finden: 
          <a href="https://ec.europa.eu/consumers/odr" target="_blank" rel="noopener noreferrer" class="text-blue-600 underline">https://ec.europa.eu/consumers/odr</a>.
        </p>
      </section>
    </div>
  </main>
</Layout>