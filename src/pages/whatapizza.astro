  <script>
    let currentLang = 'de';

    function setLang(lang) {
      currentLang = lang;
      document.documentElement.lang = lang;

      document.querySelectorAll('[data-de]').forEach(el => {
        el.textContent = el.getAttribute('data-' + lang);
      });

      const btnDe = document.getElementById('btn-de');
      const btnIt = document.getElementById('btn-it');
      if (lang === 'de') {
        btnDe.className = 'px-3 py-1 rounded-md text-xs font-bold bg-brand-green text-white transition';
        btnIt.className = 'px-3 py-1 rounded-md text-xs font-bold text-gray-600 hover:text-gray-900 transition';
      } else {
        btnIt.className = 'px-3 py-1 rounded-md text-xs font-bold bg-brand-green text-white transition';
        btnDe.className = 'px-3 py-1 rounded-md text-xs font-bold text-gray-600 hover:text-gray-900 transition';
      }
    }

    function handleRegister(e) {
      e.preventDefault();
      const pizzeria = document.getElementById('pizzeriaName').value;
      const city = document.getElementById('pizzeriaCity').value;
      const contact = document.getElementById('contactName').value;
      const phone = document.getElementById('contactPhone').value;
      const email = document.getElementById('contactEmail').value;

      const subject = encodeURIComponent(`WhataPizza Registrierung: ${pizzeria} (${city})`);
      const body = encodeURIComponent(
        `Pizzeria: ${pizzeria}\nOrt/Comune: ${city}\nAnsprechpartner: ${contact}\nTelefon/WhatsApp: ${phone}\nE-Mail: ${email}`
      );
      window.location.href = `mailto:info@seron.one?subject=${subject}&body=${body}`;
    }
  </script>
</body>
</html>
