---
import Layout from '../layouts/Layout.astro';

const currentLanguage = Astro.url.searchParams.get('lang') === 'it' ? 'it' : 'de';
---
<Layout title="WhataPizza" lang={currentLanguage}>
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
    :root {
      --ink: #17251c;
      --muted: #5e6f63;
      --green: #23824b;
      --green-dark: #12643a;
      --green-pale: #eaf5ed;
      --paper: #ffffff;
      --line: #e2ece5;
    }
    html { scroll-behavior: smooth; scroll-padding-top: 92px; }
    body { background: var(--paper); color: var(--ink); font-family: 'Inter', system-ui, sans-serif; }
    h1, h2, h3, button, input { font-family: inherit; }
    .brand-green { color: var(--green); }
    .bg-brand-green { background-color: var(--green); }
    .hover-brand-green:hover { background-color: var(--green-dark); }

    .site-header { background: rgba(255,255,255,.97); border-bottom: 1px solid var(--line); box-shadow: 0 3px 14px rgba(23,37,28,.035); backdrop-filter: blur(12px); }
    .site-header-inner { max-width: 1200px; min-height: 82px; flex-wrap: wrap; gap: 0 24px; }
    .brand-lockup { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .brand-logo { display: block; width: 174px; height: 66px; object-fit: cover; object-position: center; }
    .brand-byline { border-left: 1px solid var(--line); padding-left: 12px; color: var(--muted); font-size: 10px; font-weight: 700; line-height: 1.4; letter-spacing: 0; text-transform: uppercase; }
    .site-nav { display: flex; flex: 1; align-items: center; justify-content: center; gap: 22px; color: var(--muted); font-size: 13px; font-weight: 600; }
    .site-nav a:hover { color: var(--green); }
    .language-switcher { border: 1px solid var(--line); border-radius: 6px; background: #f5faf6; }
    .language-switcher button { border-radius: 4px; }

    .hero { overflow: hidden; border-bottom: 1px solid var(--line); background: #fff; }
    .wp-page { max-width: 1024px; margin: 0 auto; padding: 40px 16px 64px; }
    .wp-panel { overflow: hidden; border: 1px solid rgba(25,128,75,.14); border-radius: 24px; background: rgba(255,255,255,.92); box-shadow: 0 24px 70px rgba(59,32,75,.10); }
    .hero-inner { display: block; max-width: 900px; margin: 0 auto; padding: 54px 24px 46px; text-align: center; }
    .hero-copy { text-align: center; }
    .wp-logo { display: block; width: min(230px, 70vw); height: 110px; margin: 0 auto 20px; object-fit: contain; }
    .hero-eyebrow { display: inline-flex; align-items: center; gap: 9px; margin-bottom: 22px; color: var(--green); font-size: 11px; font-weight: 800; letter-spacing: 1px; text-transform: uppercase; }
    .hero-eyebrow::before { width: 8px; height: 8px; border-radius: 50%; background: var(--green); content: ''; }
    .hero h1 { max-width: 720px; margin: 0 auto 18px; color: var(--green-dark); font-size: 44px; font-weight: 800; line-height: 1.12; letter-spacing: 0; }
    .hero-copy > p { max-width: 680px; margin: 0 auto 26px; color: var(--muted); font-size: 17px; line-height: 1.7; }
    .hero-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
    .hero-actions a { border-radius: 5px; box-shadow: none; font-size: 15px; }
    .hero-primary { background: var(--green); color: white; }
    .hero-primary:hover { background: var(--green-dark); }
    .hero-secondary { border: 1px solid #d6e5da; background: white; color: var(--ink); }
    .hero-secondary:hover { background: #f1f8f3; }
    .hero-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; max-width: 620px; margin: 32px auto 0; padding-top: 19px; border-top: 1px solid var(--line); }
    .hero-facts div { color: var(--muted); font-size: 11px; line-height: 1.45; }
    .hero-facts strong { display: block; margin-bottom: 3px; color: var(--ink); font-size: 16px; }
    .hero-visual { position: relative; min-width: 0; max-width: 850px; margin: 34px auto 0; }
    .hero-screen { overflow: hidden; border: 1px solid #e1ece4; border-radius: 8px; background: #f4faf5; box-shadow: 0 18px 42px rgba(23,80,46,.12); }
    .hero-screen img { display: block; width: 100%; height: auto; }
    .screen-caption { display: flex; align-items: center; justify-content: center; gap: 20px; padding: 12px 5px 0; color: var(--muted); font-size: 12px; font-weight: 600; }
    .screen-caption span:last-child { display: inline-flex; align-items: center; gap: 7px; color: var(--green); }
    .screen-caption span:last-child::before { width: 7px; height: 7px; border-radius: 50%; background: #49a66b; content: ''; }

    #vorteile h2, #ablauf h2, #preise h2, #registrieren h2 { color: var(--green-dark); font-size: 32px; font-weight: 800; line-height: 1.2; letter-spacing: 0; }
    #vorteile > div:first-child p, #ablauf > div > div:first-child p, #preise > div:first-child p { color: var(--muted); }
    #vorteile > div:last-child > div { border-color: var(--line); border-radius: 16px; box-shadow: 0 5px 18px rgba(23,80,46,.045); text-align: center; }
    #vorteile > div:last-child > div > div:first-child { border-radius: 6px; background: var(--green-pale); color: var(--green); }
    #ablauf .grid > div { border-color: var(--line); border-radius: 16px; background: #f7fbf8; text-align: center; }
    #preise .grid > div { border-radius: 16px; box-shadow: 0 8px 26px rgba(23,80,46,.05); text-align: center; }
    #preise .grid > div:first-child { border-color: var(--green); }
    #registrieren { background: transparent; color: var(--ink); }
    #registrieren form { border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 8px 26px rgba(23,80,46,.07); text-align: left; }
    #registrieren input { border-radius: 4px; }
    #registrieren button { border-radius: 5px; }
    .wp-section { border-top: 1px solid var(--line); }
    .wp-section > div:first-child { margin-bottom: 32px; }
    .wp-section .grid { gap: 20px; }
    .wp-section .grid > div, .wp-section .grid > a { transition: transform .2s ease, box-shadow .2s ease; }
    .wp-section .grid > div:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(23,80,46,.10); }
    .wp-section nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
    .wp-section-nav a { border: 1px solid #cfe3d4; border-radius: 999px; padding: 8px 14px; color: var(--green-dark); font-size: 13px; font-weight: 700; }
    .wp-section-nav a:hover { background: var(--green-pale); }

    @media (max-width: 900px) {
      .site-nav { gap: 12px; font-size: 12px; }
      .hero h1 { font-size: 40px; }
    }
    @media (max-width: 720px) {
      .site-header-inner { padding-top: 8px; padding-bottom: 8px; }
      .brand-logo { width: 142px; height: 56px; }
      .brand-byline { display: none; }
      .site-nav { order: 3; flex-basis: 100%; justify-content: flex-start; overflow-x: auto; padding: 9px 0 3px; white-space: nowrap; }
      .site-nav a { flex: 0 0 auto; }
      .wp-page { padding: 24px 12px 40px; }
      .wp-panel { border-radius: 18px; }
      .hero-inner { padding: 38px 18px 34px; }
      .hero h1 { font-size: 34px; }
      .hero-copy > p { font-size: 16px; }
      .hero-screen { border-width: 1px; }
      .hero-facts { gap: 8px; }
      .hero-facts strong { font-size: 14px; }
      #vorteile h2, #ablauf h2, #preise h2, #registrieren h2 { font-size: 29px; }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after { transition-duration: .01ms !important; }
    }
  </style>
  <main class="wp-page">
    <div class="wp-panel">
  <!-- Hero Section -->
  <section class="hero" id="top">
    <div class="hero-inner">
      <div class="hero-copy">
      <img src="/WhataPizza_logo.png" alt="WhataPizza" class="wp-logo" />
      <span class="hero-eyebrow"
            data-de="Für Pizzerien & Take-Away · Powered by Seron"
            data-it="Per Pizzerie & Asporto · Powered by Seron">
        Für Pizzerien & Take-Away · Powered by Seron
      </span>
      <h1 data-de="Mehr Bestellungen. Weniger Telefonstress."
          data-it="Più ordini. Meno stress al telefono.">
        Mehr Bestellungen. Weniger Telefonstress.
      </h1>
      <p
         data-de="Ihre Gäste scannen Ihren QR-Code, schreiben ihre Bestellung in einer einzigen WhatsApp-Nachricht und Sie bestätigen die Abholzeit mit nur einem Klick – ganz ohne Lieferportal-Provisionen."
         data-it="I tuoi clienti scansionano il QR-Code, scrivono l'ordine in un unico messaggio WhatsApp e tu confermi l'orario di ritiro con un solo clic – senza commissioni dei portali di delivery.">
        Ihre Gäste scannen Ihren QR-Code, schreiben ihre Bestellung in einer einzigen WhatsApp-Nachricht und Sie bestätigen die Abholzeit mit nur einem Klick – ganz ohne Lieferportal-Provisionen.
      </p>
      <div class="hero-actions">
        <a href="#registrieren" class="hero-primary px-7 py-3.5 font-bold transition"
           data-de="Jetzt Pizzeria anmelden"
           data-it="Registra ora la tua Pizzeria">
          Jetzt Pizzeria anmelden
        </a>
        <a href="#ablauf" class="hero-secondary px-7 py-3.5 font-semibold transition"
           data-de="Ablauf ansehen"
           data-it="Scopri come funziona">
          Ablauf ansehen
        </a>
      </div>
      <div class="hero-facts">
        <div><strong>0 €</strong><span data-de="Grundgebühr" data-it="Canone fisso">Grundgebühr</span></div>
        <div><strong>10 ct</strong><span data-de="pro Pizza" data-it="per pizza">pro Pizza</span></div>
        <div><strong>1 Klick</strong><span data-de="zur Abholbestätigung" data-it="per confermare il ritiro">zur Abholbestätigung</span></div>
      </div>
      </div>
      <div class="hero-visual">
        <figure class="hero-screen">
          <img src="/slideshows/tableator-images/whatspizza-overview.png" alt="WhataPizza-Dashboard mit WhatsApp-Nachrichten und Bestellübersicht" />
        </figure>
        <div class="screen-caption">
          <span data-de="Bestellungen und Chats an einem Ort" data-it="Ordini e chat in un unico posto">Bestellungen und Chats an einem Ort</span>
          <span data-de="Live-Übersicht" data-it="In tempo reale">Live-Übersicht</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Vorteile / Vantaggi -->
  <section id="vorteile" class="wp-section max-w-6xl mx-auto px-4 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-extrabold text-gray-900"
          data-de="Warum Pizzerien auf WhataPizza setzen"
          data-it="Perché le pizzerie scelgono WhataPizza">
        Warum Pizzerien auf WhataPizza setzen
      </h2>
      <p class="text-gray-600 mt-2"
         data-de="Entwickelt für maximale Zeitersparnis am Ofen und an der Kasse."
         data-it="Progettato per risparmiare tempo prezioso al forno e alla cassa.">
        Entwickelt für maximale Zeitersparnis am Ofen und an der Kasse.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      <!-- Card 1 -->
      <div class="bg-white p-7 rounded-2xl shadow-sm border border-gray-100">
        <div class="w-12 h-12 rounded-xl bg-green-100 brand-green flex items-center justify-center text-2xl mb-4">⏱️</div>
        <h3 class="text-xl font-bold mb-2"
            data-de="Massive Zeitersparnis"
            data-it="Enorme risparmio di tempo">
          Massive Zeitersparnis
        </h3>
        <p class="text-gray-600 text-sm leading-relaxed"
           data-de="Kein ständiges Telefonklingeln, kein mühsames Mitschreiben auf Zetteln und keine Missverständnisse bei Sonderwünschen. Alle Bestellungen erscheinen sauber strukturiert auf Ihrem Tablet oder Bondrucker."
           data-it="Niente più telefono che squilla di continuo, niente appunti presi di fretta e zero malintesi sulle aggiunte. Tutti gli ordini arrivano chiari e ordinati sul tuo tablet o sulla stampante termica.">
          Kein ständiges Telefonklingeln, kein mühsames Mitschreiben auf Zetteln und keine Missverständnisse bei Sonderwünschen. Alle Bestellungen erscheinen sauber strukturiert auf Ihrem Tablet oder Bondrucker.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="bg-white p-7 rounded-2xl shadow-sm border border-gray-100">
        <div class="w-12 h-12 rounded-xl bg-green-100 brand-green flex items-center justify-center text-2xl mb-4">📲</div>
        <h3 class="text-xl font-bold mb-2"
            data-de="Keine App & keine Registrierung für Gäste"
            data-it="Nessuna App o registrazione per i clienti">
          Keine App & keine Registrierung für Gäste
        </h3>
        <p class="text-gray-600 text-sm leading-relaxed"
           data-de="Jeder Gast hat bereits WhatsApp. QR-Code scannen, Pizzen + FERTIG/FINE + Name schreiben, absenden. Keine Passwörter, keine Hürden – sofortige Umstellung Ihrer Stammkunden."
           data-it="Tutti hanno già WhatsApp. Scansionano il QR-Code, scrivono le pizze + FINE + nome e inviano. Nessuna password, nessun ostacolo: i clienti abituali passano subito a WhatsApp.">
          Jeder Gast hat bereits WhatsApp. QR-Code scannen, Pizzen + FERTIG/FINE + Name schreiben, absenden. Keine Passwörter, keine Hürden – sofortige Umstellung Ihrer Stammkunden.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="bg-white p-7 rounded-2xl shadow-sm border border-gray-100">
        <div class="w-12 h-12 rounded-xl bg-green-100 brand-green flex items-center justify-center text-2xl mb-4">🎁</div>
        <h3 class="text-xl font-bold mb-2"
            data-de="Stempelkarte & Stammkunden-Bindung"
            data-it="Carta fedeltà & fidelizzazione clienti">
          Stempelkarte & Stammkunden-Bindung
        </h3>
        <p class="text-gray-600 text-sm leading-relaxed"
           data-de="Belohnen Sie WhatsApp-Besteller automatisch (z. B. 10 Pizzen = 1 Gratis-Pizza) und holen Sie Stammkunden an ruhigen Abenden DSGVO-konform per Reminder zurück."
           data-it="Premia automaticamente chi ordina su WhatsApp (es. 10 pizze = 1 pizza omaggio) e richiama i clienti abituali nelle serate più tranquille con promemoria conformi al GDPR.">
          Belohnen Sie WhatsApp-Besteller automatisch (z. B. 10 Pizzen = 1 Gratis-Pizza) und holen Sie Stammkunden an ruhigen Abenden DSGVO-konform per Reminder zurück.
        </p>
      </div>
    </div>
  </section>

  <!-- So registrieren sich Pizzerien -->
  <section id="ablauf" class="wp-section bg-white border-y border-gray-100 py-16">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-extrabold text-gray-900"
            data-de="In 3 einfachen Schritten startklar"
            data-it="Pronti a partire in 3 semplici passaggi">
          In 3 einfachen Schritten startklar
        </h2>
        <p class="text-gray-600 mt-2"
           data-de="Wir richten alles schlüsselfertig für Ihre Pizzeria ein."
           data-it="Prepariamo tutto chiavi in mano per la tua pizzeria.">
          Wir richten alles schlüsselfertig für Ihre Pizzeria ein.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="relative p-6 rounded-2xl bg-gray-50 border border-gray-200">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-brand-green text-white font-bold mb-4">1</span>
          <h3 class="font-bold text-lg mb-2"
              data-de="Anmelden & Speisekarte senden"
              data-it="Registrati e invia il menù">
            Anmelden & Speisekarte senden
          </h3>
          <p class="text-sm text-gray-600"
             data-de="Füllen Sie das Formular unten aus und schicken Sie uns Ihre Speisekarte sowie Öffnungszeiten. Wir legen Ihren persönlichen Bestell-Hashtag (z. B. #ihrepizzeria) an."
             data-it="Compila il modulo qui sotto e inviaci il tuo menù e gli orari di apertura. Creiamo subito il tuo hashtag dedicato (es. #latuapizzeria).">
            Füllen Sie das Formular unten aus und schicken Sie uns Ihre Speisekarte sowie Öffnungszeiten. Wir legen Ihren persönlichen Bestell-Hashtag (z. B. #ihrepizzeria) an.
          </p>
        </div>

        <div class="relative p-6 rounded-2xl bg-gray-50 border border-gray-200">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-brand-green text-white font-bold mb-4">2</span>
          <h3 class="font-bold text-lg mb-2"
              data-de="QR-Code & Flyer erhalten"
              data-it="Ricevi QR-Code e volantini">
            QR-Code & Flyer erhalten
          </h3>
          <p class="text-sm text-gray-600"
             data-de="Sie erhalten Ihren druckfertigen QR-Code sowie auf Wunsch gestaltete Theken-Flyer und Visitenkarten zum Beilegen zu Ihren Pizzabestellungen."
             data-it="Ricevi il tuo QR-Code pronto per la stampa e, su richiesta, volantini da banco e biglietti da visita da inserire nelle confezioni delle pizze.">
            Sie erhalten Ihren druckfertigen QR-Code sowie auf Wunsch gestaltete Theken-Flyer und Visitenkarten zum Beilegen zu Ihren Pizzabestellungen.
          </p>
        </div>

        <div class="relative p-6 rounded-2xl bg-gray-50 border border-gray-200">
          <span class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-brand-green text-white font-bold mb-4">3</span>
          <h3 class="font-bold text-lg mb-2"
              data-de="Bestellungen per Klick bestätigen"
              data-it="Conferma gli ordini con un clic">
            Bestellungen per Klick bestätigen
          </h3>
          <p class="text-sm text-gray-600"
             data-de="Öffnen Sie das WhataPizza-Dashboard auf Ihrem Tablet oder PC. Neue WhatsApp-Bestellungen erscheinen sofort – Sie tippen nur die Abholzeit an."
             data-it="Apri la dashboard WhataPizza sul tuo tablet o PC. I nuovi ordini WhatsApp appaiono all'istante: ti basta selezionare l'orario di ritiro.">
            Öffnen Sie das WhataPizza-Dashboard auf Ihrem Tablet oder PC. Neue WhatsApp-Bestellungen erscheinen sofort – Sie tippen nur die Abholzeit an.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Preise / Prezzi -->
  <section id="preise" class="wp-section max-w-5xl mx-auto px-4 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-extrabold text-gray-900"
          data-de="Transparente Preise ohne Umsatzbeteiligung"
          data-it="Prezzi trasparenti senza percentuali sull'incasso">
        Transparente Preise ohne Umsatzbeteiligung
      </h2>
      <p class="text-gray-600 mt-2"
         data-de="Keine 15–30 % Provision wie bei Lieferportalen. Sie zahlen nur bei echten Bestellungen."
         data-it="Niente commissioni del 15–30% come sui portali di delivery. Paghi solo sugli ordini reali.">
        Keine 15–30 % Provision wie bei Lieferportalen. Sie zahlen nur bei echten Bestellungen.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 items-stretch">
      <!-- Basis-Modell -->
      <div class="bg-white p-8 rounded-2xl shadow-sm border-2 border-green-600 flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider brand-green"
                data-de="Standard-Tarif"
                data-it="Tariffa Standard">
            Standard-Tarif
          </span>
          <h3 class="text-2xl font-extrabold mt-1 mb-4"
              data-de="0 € Grundgebühr · 10 Cent / Pizza"
              data-it="0 € Canone fisso · 10 Cent / Pizza">
            0 € Grundgebühr · 10 Cent / Pizza
          </h3>
          <ul class="space-y-3 text-sm text-gray-700 mb-6">
            <li data-de="✓ Einmalige Einrichtung: 99 € (inkl. QR-Code & Startpaket Flyer)"
                data-it="✓ Attivazione una tantum: 99 € (incl. QR-Code e pacchetto iniziale volantini)">
              ✓ Einmalige Einrichtung: 99 € (inkl. QR-Code & Startpaket Flyer)
            </li>
            <li data-de="✓ 0 € Fixkosten – bei 0 WhatsApp-Bestellungen zahlen Sie 0 €"
                data-it="✓ 0 € costi fissi – con 0 ordini WhatsApp paghi 0 €">
              ✓ 0 € Fixkosten – bei 0 WhatsApp-Bestellungen zahlen Sie 0 €
            </li>
            <li data-de="✓ Fair-Use-Kostendeckel: Maximal 149 € / Monat (danach kostenlos)"
                data-it="✓ Tetto massimo garantito: Massimo 149 € / mese (oltre è gratuito)">
              ✓ Fair-Use-Kostendeckel: Maximal 149 € / Monat (danach kostenlos)
            </li>
            <li data-de="✓ Monatlich kündbar ohne Mindestlaufzeit"
                data-it="✓ Disdicibile mensilmente senza vincoli">
              ✓ Monatlich kündbar ohne Mindestlaufzeit
            </li>
          </ul>
        </div>
        <a href="#registrieren" class="block text-center w-full py-3 rounded-xl bg-brand-green hover-brand-green text-white font-bold transition"
           data-de="Unverbindlich anfragen"
           data-it="Richiedi attivazione">
          Unverbindlich anfragen
        </a>
      </div>

      <!-- Optionales Upgrade -->
      <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-200 flex flex-col justify-between">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-gray-500"
                data-de="Optionales Zusatzmodul"
                data-it="Modulo aggiuntivo opzionale">
            Optionales Zusatzmodul
          </span>
          <h3 class="text-2xl font-extrabold mt-1 mb-4"
              data-de="Digitale Stempelkarte & Reminder (+19 €/Monat)"
              data-it="Carta Fedeltà Digitale & Reminder (+19 €/mese)">
            Digitale Stempelkarte & Reminder (+19 €/Monat)
          </h3>
          <ul class="space-y-3 text-sm text-gray-700 mb-6">
            <li data-de="✓ Automatischer Punktezähler pro Handynummer (z. B. 10+1 Gratis)"
                data-it="✓ Contatore punti automatico per numero di telefono (es. 10+1 Omaggio)">
              ✓ Automatischer Punktezähler pro Handynummer (z. B. 10+1 Gratis)
            </li>
            <li data-de="✓ Automatische Status-Info in jeder Bestellbestätigung"
                data-it="✓ Aggiornamento punti automatico in ogni conferma d'ordine">
              ✓ Automatische Status-Info in jeder Bestellbestätigung
            </li>
            <li data-de="✓ DSGVO-konformes WhatsApp-Opt-in & Abmeldefunktion (STOP)"
                data-it="✓ Opt-in WhatsApp conforme al GDPR e disiscrizione (STOP)">
              ✓ DSGVO-konformes WhatsApp-Opt-in & Abmeldefunktion (STOP)
            </li>
            <li data-de="✓ Aktive Stammkunden-Reminder an ruhigen Abenden"
                data-it="✓ Promemoria attivi ai clienti abituali nelle serate tranquille">
              ✓ Aktive Stammkunden-Reminder an ruhigen Abenden
            </li>
          </ul>
        </div>
        <p class="text-xs text-gray-500"
           data-de="Jederzeit im Pizzeria-Dashboard aktivierbar oder deaktivierbar."
           data-it="Attivabile o disattivabile in qualsiasi momento dalla dashboard.">
          Jederzeit im Pizzeria-Dashboard aktivierbar oder deaktivierbar.
        </p>
      </div>
    </div>
  </section>

  <!-- Registrierungsformular -->
  <section id="registrieren" class="wp-section py-16">
    <div class="max-w-3xl mx-auto px-4">
      <div class="text-center mb-8">
        <h2 class="text-3xl font-extrabold"
            data-de="Pizzeria kostenlos & unverbindlich anmelden"
            data-it="Registra la tua Pizzeria senza impegno">
          Pizzeria kostenlos & unverbindlich anmelden
        </h2>
        <p class="text-green-100 mt-2"
           data-de="Wir melden uns innerhalb von 24 Stunden mit Ihrem persönlichen Demo-Link und QR-Code."
           data-it="Ti ricontattiamo entro 24 ore con il tuo link demo personale e il QR-Code.">
          Wir melden uns innerhalb von 24 Stunden mit Ihrem persönlichen Demo-Link und QR-Code.
        </p>
      </div>

      <form onsubmit="handleRegister(event)" class="bg-white text-gray-800 p-8 rounded-2xl shadow-lg space-y-4">
        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase text-gray-600 mb-1"
                   data-de="Name der Pizzeria *"
                   data-it="Nome della Pizzeria *">Name der Pizzeria *</label>
            <input type="text" id="pizzeriaName" required placeholder="z. B. Pizzeria Tomato"
                   class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:outline-none focus:border-green-600" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase text-gray-600 mb-1"
                   data-de="Ort / Gemeinde *"
                   data-it="Località / Comune *">Ort / Gemeinde *</label>
            <input type="text" id="pizzeriaCity" required placeholder="z. B. Schlanders / Silandro"
                   class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:outline-none focus:border-green-600" />
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold uppercase text-gray-600 mb-1"
                   data-de="Ansprechpartner *"
                   data-it="Referente *">Ansprechpartner *</label>
            <input type="text" id="contactName" required
                   class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:outline-none focus:border-green-600" />
          </div>
          <div>
            <label class="block text-xs font-bold uppercase text-gray-600 mb-1"
                   data-de="Telefon / WhatsApp *"
                   data-it="Telefono / WhatsApp *">Telefon / WhatsApp *</label>
            <input type="tel" id="contactPhone" required placeholder="+39 ..."
                   class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:outline-none focus:border-green-600" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold uppercase text-gray-600 mb-1"
                 data-de="E-Mail-Adresse *"
                 data-it="Indirizzo E-Mail *">E-Mail-Adresse *</label>
          <input type="email" id="contactEmail" required
                 class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:outline-none focus:border-green-600" />
        </div>

        <div class="flex items-start gap-2 pt-2">
          <input type="checkbox" id="privacyCheck" required class="mt-1" />
          <label for="privacyCheck" class="text-xs text-gray-600"
                 data-de="Ich stimme zu, dass meine Angaben zur Kontaktaufnahme und Einrichtung eines unverbindlichen Testzugangs durch Seron S.r.l. verarbeitet werden."
                 data-it="Acconsento al trattamento dei miei dati da parte di Seron S.r.l. per essere ricontattato e attivare una demo senza impegno.">
            Ich stimme zu, dass meine Angaben zur Kontaktaufnahme und Einrichtung eines unverbindlichen Testzugangs durch Seron S.r.l. verarbeitet werden.
          </label>
        </div>

        <button type="submit" class="w-full py-3.5 rounded-xl bg-brand-green hover-brand-green text-white font-bold text-lg shadow transition"
                data-de="Jetzt unverbindlich anmelden"
                data-it="Invia richiesta di registrazione">
          Jetzt unverbindlich anmelden
        </button>
      </form>
    </div>
  </section>

    </div>
  </main>
  <script is:inline>
    const language = new URLSearchParams(window.location.search).get('lang') === 'it' ? 'it' : 'de';
    document.documentElement.lang = language;
    document.querySelectorAll('[data-de]').forEach(element => {
      element.textContent = element.getAttribute('data-' + language);
    });

    function handleRegister(e) {
      e.preventDefault();
      const pizzeria = document.getElementById('pizzeriaName').value;
      const city = document.getElementById('pizzeriaCity').value;
      const contact = document.getElementById('contactName').value;
      const phone = document.getElementById('contactPhone').value;
      const email = document.getElementById('contactEmail').value;

      const subject = encodeURIComponent(`WhataPizza Registrierung: ${pizzeria} (${city})`);
      const body = encodeURIComponent(
        `Pizzeria: ${pizzeria}\nOrt/Comune: ${city}\nAnsprechpartner: ${contact}\nTelefon/WhatsApp: ${phone}\nE-Mail: ${email}`
      );
      window.location.href = `mailto:info@seron.one?subject=${subject}&body=${body}`;
    }
  </script>
</Layout>
