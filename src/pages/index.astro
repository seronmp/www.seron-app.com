---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home - Seron S.r.l.">
  <main class="flex-grow max-w-7xl mx-auto px-4 sm:px-6 py-16 md:py-24 w-full relative z-10">
    
    <!-- Intestazione -->
    <div class="text-center mb-16 md:mb-20 relative">
      <div class="inline-block relative">
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-black text-gray-800 mb-4 tracking-tight">Soluzioni Software</h1>
        <div class="absolute -bottom-3 left-1/2 transform -translate-x-1/2 w-24 h-1.5 bg-gradient-to-r from-blue-500 to-indigo-500 rounded-full"></div>
      </div>
      <p class="text-gray-600 text-lg sm:text-xl mt-6 max-w-2xl mx-auto px-2">Soluzioni digitali e gestionali avanzate per le aziende.</p>
    </div>

    <!-- Griglia delle Mattonelle Grandi e Responsive -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8 md:gap-10">
      
      <!-- Card: Salon -->
      <a href="https://whatsapp-salon-api.emergent.host" target="_blank" rel="noopener noreferrer" class="group relative bg-white/40 backdrop-blur-2xl p-6 sm:p-10 md:p-14 rounded-3xl border border-white/60 shadow-[0_8px_30px_rgb(0,0,0,0.04)] transition-all duration-500 hover:-translate-y-2.5 hover:bg-white/70 hover:shadow-[0_20px_50px_rgba(59,130,246,0.15)] hover:border-blue-300 overflow-hidden">
        <div class="absolute top-0 left-0 w-2.5 h-full bg-blue-500 transition-all duration-300 group-hover:w-3.5"></div>
        <div class="absolute -right-20 -bottom-20 w-56 h-56 bg-blue-400/10 rounded-full blur-3xl group-hover:bg-blue-400/20 transition-all duration-500"></div>
        <h3 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-gray-800 group-hover:text-blue-600 transition-colors mb-3 sm:mb-4">Salon</h3>
        <p class="text-gray-600 text-base sm:text-lg leading-relaxed">Gestione e organizzazione appuntamenti. Ottimizza i flussi di lavoro con la nostra soluzione dedicata.</p>
      </a>

      <!-- Card: Tableator -->
      <a href="/tableator" class="group relative bg-white/40 backdrop-blur-2xl p-6 sm:p-10 md:p-14 rounded-3xl border border-white/60 shadow-[0_8px_30px_rgb(0,0,0,0.04)] transition-all duration-500 hover:-translate-y-2.5 hover:bg-white/70 hover:shadow-[0_20px_50px_rgba(99,102,241,0.15)] hover:border-indigo-300 overflow-hidden">
        <div class="absolute top-0 left-0 w-2.5 h-full bg-indigo-500 transition-all duration-300 group-hover:w-3.5"></div>
        <div class="absolute -right-20 -bottom-20 w-56 h-56 bg-indigo-400/10 rounded-full blur-3xl group-hover:bg-indigo-400/20 transition-all duration-500"></div>
        <h3 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-gray-800 group-hover:text-indigo-600 transition-colors mb-3 sm:mb-4">Tableator</h3>
        <p class="text-gray-600 text-base sm:text-lg leading-relaxed">Strumento avanzato per l'elaborazione e la visualizzazione dinamica dei tavoli in ristoranti e pizzerie.</p>
      </a>

      <!-- Card: Zeitlr -->
      <a href="https://seronmp.github.io/Zeitlr/" target="_blank" rel="noopener noreferrer" class="group relative bg-white/40 backdrop-blur-2xl p-6 sm:p-10 md:p-14 rounded-3xl border border-white/60 shadow-[0_8px_30px_rgb(0,0,0,0.04)] transition-all duration-500 hover:-translate-y-2.5 hover:bg-white/70 hover:shadow-[0_20px_50px_rgba(168,85,247,0.15)] hover:border-purple-300 overflow-hidden">
        <div class="absolute top-0 left-0 w-2.5 h-full bg-purple-500 transition-all duration-300 group-hover:w-3.5"></div>
        <div class="absolute -right-20 -bottom-20 w-56 h-56 bg-purple-400/10 rounded-full blur-3xl group-hover:bg-purple-400/20 transition-all duration-500"></div>
        <h3 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-gray-800 group-hover:text-purple-600 transition-colors mb-3 sm:mb-4">Zeitlr</h3>
        <p class="text-gray-600 text-base sm:text-lg leading-relaxed">Gestione intelligente e tracciamento delle tempistiche e delle attività aziendali.</p>
      </a>

      <!-- Card: Calcolatore Acustico -->
      <a href="https://seronmp.github.io/RaumAkustikRechner/" target="_blank" rel="noopener noreferrer" class="group relative bg-white/40 backdrop-blur-2xl p-6 sm:p-10 md:p-14 rounded-3xl border border-white/60 shadow-[0_8px_30px_rgb(0,0,0,0.04)] transition-all duration-500 hover:-translate-y-2.5 hover:bg-white/70 hover:shadow-[0_20px_50px_rgba(16,185,129,0.15)] hover:border-emerald-300 overflow-hidden">
        <div class="absolute top-0 left-0 w-2.5 h-full bg-emerald-500 transition-all duration-300 group-hover:w-3.5"></div>
        <div class="absolute -right-20 -bottom-20 w-56 h-56 bg-emerald-400/10 rounded-full blur-3xl group-hover:bg-emerald-400/20 transition-all duration-500"></div>
        <h3 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-gray-800 group-hover:text-emerald-600 transition-colors mb-3 sm:mb-4">Calcolatore Acustico</h3>
        <p class="text-gray-600 text-base sm:text-lg leading-relaxed">Strumento professionale per il calcolo del tempo di riverbero e l'ottimizzazione del trattamento acustico.</p>
      </a>

    </div>
  </main>
</Layout>